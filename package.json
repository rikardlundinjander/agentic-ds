{
  "name": "agentic-ds",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of concept: layered design tokens (primitives, brand, mode, semantic) built with Style Dictionary and documented in Storybook.",
  "type": "module",
  "scripts": {
    "tokens:validate": "node scripts/validate-tokens.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens": "npm run tokens:validate && npm run tokens:build",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.6.2",
    "style-dictionary": "^5.6.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
