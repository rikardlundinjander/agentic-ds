{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "serif": { "$value": ["Georgia", "Times New Roman", "serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "100": { "$value": "12px" },
      "200": { "$value": "14px" },
      "300": { "$value": "16px" },
      "400": { "$value": "20px" },
      "500": { "$value": "24px" },
      "600": { "$value": "32px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "normal": { "$value": 1.5 }
    }
  }
}
