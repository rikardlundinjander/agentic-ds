{
  "name": "@rikardlundinjander/agentic-ds",
  "version": "0.1.0",
  "description": "Design tokens (primitives, brand, mode, semantic) built with Style Dictionary for web, iOS and Android.",
  "type": "module",
  "scripts": {
    "tokens:validate": "node scripts/validate-tokens.mjs",
    "tokens:build": "node scripts/build-tokens.mjs && node scripts/build-platforms.mjs",
    "tokens": "npm run tokens:validate && npm run tokens:build",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "prepack": "npm run tokens"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.6.2",
    "style-dictionary": "^5.6.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rikardlundinjander/agentic-ds.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./css": "./dist/css/tokens.css",
    "./tokens.json": "./dist/json/tokens.json",
    "./json/*": "./dist/json/*.json",
    "./js/*": {
      "types": "./dist/js/*.d.ts",
      "default": "./dist/js/*.js"
    },
    "./scss/*": "./dist/scss/*.scss",
    "./ios/*": "./dist/ios/*",
    "./android/*": "./dist/android/*",
    "./compose/*": "./dist/compose/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
